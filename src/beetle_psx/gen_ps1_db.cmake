# Turns Beetle PSX's database/psx_games.inc (Redump serial/title catalog) into ps1_db_data.cpp:
#   extern const hub::Ps1DbRow hub::kPs1Db[]; extern const size_t hub::kPs1DbCount;  (declared in src/common/ps1.h)
function(ps1_db_generate inc out)
    file(STRINGS ${inc} lines REGEX "^PSX_GAME(_COMPAT)?\\(")
    set(body "")
    set(n 0)
    foreach(l IN LISTS lines)
        if(l MATCHES "^PSX_GAME(_COMPAT)?\\(\"[0-9]*\", *\"([A-Z0-9-]+)\", *\"[^\"]*\", *\"([A-Za-z ]*)\", *\"[^\"]*\", *\"(.*)\"(,.*)?\\)")
            set(serial "${CMAKE_MATCH_2}")
            set(cat "${CMAKE_MATCH_3}")
            set(title "${CMAKE_MATCH_4}")
            string(REPLACE "\\" "\\\\" title "${title}")
            string(REPLACE "\"" "\\\"" title "${title}")
            string(APPEND body "{\"${serial}\",\"${title}\"},\n")
            math(EXPR n "${n}+1")
        endif()
    endforeach()
    file(WRITE ${out} "// Generated by gen_ps1_db.cmake from Beetle PSX database/psx_games.inc (Redump serial catalog). Do not edit.\n#include \"ps1.h\"\nnamespace hub {\nconst Ps1DbRow kPs1Db[] = {\n${body}{nullptr,nullptr}};\nconst size_t kPs1DbCount = ${n};\n}\n")
    message(STATUS "ps1 db: ${n} rows")
endfunction()
