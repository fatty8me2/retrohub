// RetroHub resources: application icon + version info. Included (after optional RH_* overrides) by the
// per-exe .rc files; compiled directly into RetroHub.exe.
#include <winres.h>
#include "resource.h"
#include "hub_version_rc.h"   // generated by CMake: RH_VER_MAJOR/MINOR/PATCH, RH_VER_STR

#ifndef RH_FILE_DESC
#define RH_FILE_DESC "RetroHub"
#endif
#ifndef RH_ORIG_NAME
#define RH_ORIG_NAME "RetroHub.exe"
#endif

IDI_APPICON ICON "../../assets/brand/retrohub.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RH_VER_MAJOR,RH_VER_MINOR,RH_VER_PATCH,0
 PRODUCTVERSION RH_VER_MAJOR,RH_VER_MINOR,RH_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RetroHub"
            VALUE "FileDescription", RH_FILE_DESC
            VALUE "FileVersion", RH_VER_STR
            VALUE "InternalName", "RetroHub"
            VALUE "LegalCopyright", "RetroHub"
            VALUE "OriginalFilename", RH_ORIG_NAME
            VALUE "ProductName", "RetroHub"
            VALUE "ProductVersion", RH_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
